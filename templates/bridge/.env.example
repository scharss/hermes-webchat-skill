# Hermes Webchat bridge
WEBCHAT_BASE_URL=https://yourdomain.com/chat
WEBCHAT_TOKEN=apch_generate_it_in_admin

AGENT_API_URL=http://hermes:8642
AGENT_API_KEY=
AGENT_MODEL=hermes-agent

MEDIA_ROOTS=/opt/data/exports,/opt/data/media
INBOX_DIR=/opt/data/inbox
WEBCHAT_MAX_ATTACHMENT_MB=25

# WEBCHAT_POLL_WAIT=20
# WEBCHAT_HEARTBEAT_SECONDS=60
# WEBCHAT_APPROVAL_SECONDS=280
